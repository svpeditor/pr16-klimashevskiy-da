digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить список документов и размер пула" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n1b [label="Пул от 1 до 25,\nid не повторяются" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n1e [label="IllegalArgumentException,\nпакет не\nобрабатывается"];
n2 [label="Создать фиксированный пул\nnewFixedThreadPool(poolSize)"];
n3 [label="A1 Создать Callable\nдля каждого документа:\n() -> processor.process(d)"];
n4 [label="Отправить задачи\nexecutor.submit(task),\nFuture в список"];
n5 [label="Получать результаты\nfuture.get()\nпо порядку списка"];
n6 [label="Задача\nзавершилась\nуспешно" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n7 [label="Безопасно обновить\nагрегаты: registerSuccess()\n(AtomicInteger)"];
n8 [label="Зафиксировать ошибку\nдокумента: registerError(id,\nпричина) в ConcurrentHashMap"];
n9 [label="Закрыть пул\nexecutor.shutdown()\nв finally"];
start -> n1;
n1 -> n1b;
n1b -> n2 [label="да"];
n1b -> n1e [label="нет"];
n1e -> end;
n2 -> n3;
n3 -> n4;
n4 -> n5;
n5 -> n6;
n6 -> n7 [label="да"];
n6 -> n8 [label="нет"];
n7 -> n5 [label="еще результаты"];
n8 -> n5 [label="еще результаты"];
n5 -> n9 [label="все получены"];
n9 -> end;
}
